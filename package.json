{
  "name": "gdcc-eoffice-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "lint:links": "node ./scripts/lint-links.mjs",
    "security:check": "pnpm audit --audit-level=high",
    "media:localize": "node scripts/localize-images.mjs",
    "media:uuid-rename": "node scripts/uuid-rename-images.mjs",
    "media:prune": "node scripts/prune-unused-images.mjs --dry-run",
    "media:prune:delete": "node scripts/prune-unused-images.mjs --delete"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "~6.7.2",
    "@fortawesome/free-brands-svg-icons": "~6.7.2",
    "@fortawesome/free-regular-svg-icons": "~6.7.2",
    "@fortawesome/free-solid-svg-icons": "~6.7.2",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@fumadocs/mdx-remote": "^1.5.3",
    "cnfast": "^0.2.0",
    "fumadocs-core": "16.18.3",
    "fumadocs-mdx": "15.5.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.3",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "next-validate-link": "^1.6.7",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.19.0 <13"
  },
  "packageManager": "pnpm@12.19.0"
}
